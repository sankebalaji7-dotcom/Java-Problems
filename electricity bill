import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int units = sc.nextInt();
        int bill;

        if (units <= 100) {
            bill = units * 2;
        }
        else if (units <= 200) {
            bill = units * 3;
        }
        else if (units <= 300) {
            bill = units * 5;
        }
        else {
            bill = units * 7;
        }

        System.out.println("Electricity Bill = " + bill);
    }
}
